# ============================================================
# AI 助手服务配置
# 复制本文件为 .env 后填写：cp .env.example .env
# ⚠️ .env 含密钥，已在 .gitignore 中排除，请勿提交
# ============================================================

# 服务监听端口
PORT=3003

# ------------------------------------------------------------
# 大模型接口（OpenAI 兼容格式）
# ------------------------------------------------------------
# 你的 API Key（必填）
AI_API_KEY=

# 接口地址（选一个）
#   DeepSeek : https://api.deepseek.com/v1/chat/completions
#   阿里通义 : https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   智谱GLM  : https://open.bigmodel.cn/api/paas/v4/chat/completions
#   OpenAI   : https://api.openai.com/v1/chat/completions
AI_BASE_URL=https://api.deepseek.com/v1/chat/completions

# 模型名称
AI_MODEL=deepseek-chat

# 系统提示词（可选，不填用内置默认值）
# AI_SYSTEM_PROMPT=你是钢板仓数字孪生系统的智能助手。

# ------------------------------------------------------------
# 跨域来源
# ------------------------------------------------------------
# 默认 * 允许所有来源（演示用）。
# 生产环境建议改成前端实际地址，多个用逗号分隔，例如：
#   CORS_ORIGIN=https://your-domain.com,http://192.168.1.100:8080
CORS_ORIGIN=*
